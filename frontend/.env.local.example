# Backend (FastAPI) base URL, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase project URL and anon/publishable key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local dev only, skips login (backend needs AUTH_DISABLED=1 too). NEVER set in production.
# NEXT_PUBLIC_AUTH_DISABLED=1
