# Supabase -> Project -> Connect -> "Session pooler" connection string (IPv4, port 5432).
DATABASE_URL=postgresql://postgres.YOURREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Used to verify user JWTs (JWKS). https://YOURREF.supabase.co
SUPABASE_URL=https://YOURREF.supabase.co
# Only if your project still signs with the legacy HS256 secret (Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=
# Shared secret for POST /api/ingest (any long random string)
INGEST_KEY=change-me
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000
# 1 = run the built-in live simulator for mill RM-03
LIVE_SIM=0
# Local development only: skip JWT checks. NEVER set in production.
AUTH_DISABLED=0
